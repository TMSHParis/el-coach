generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// user_id = Clerk user id (auth reste géré par Clerk, pas de table auth ici).
model Profile {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  prenom            String
  // Date de naissance (l'âge est calculé à la volée, plus jamais stocké).
  dateNaissance     DateTime? @map("date_naissance") @db.Date
  taille            Int
  poids             Float
  objectif          String  @map("objectif_1")
  objectif2         String? @map("objectif_2")
  // Objectifs enrichis (sous-catégorie/deadline/priorité, ou événement pour "Je prépare mon corps à...").
  objectif1Type     String? @map("objectif_1_type")
  objectif1SousCat  String? @map("objectif_1_sous_cat")
  objectif1Deadline String? @map("objectif_1_deadline")
  objectif1Priorite String? @map("objectif_1_priorite")
  objectif1Event    String? @map("objectif_1_event")
  objectif2Type     String? @map("objectif_2_type")
  objectif2SousCat  String? @map("objectif_2_sous_cat")
  objectif2Deadline String? @map("objectif_2_deadline")
  objectif2Priorite String? @map("objectif_2_priorite")
  objectif2Event    String? @map("objectif_2_event")
  // Hyrox (partie 2, 2.4) : date exacte de la course (YYYY-MM-DD) et catégorie.
  objectif1DateExacte String? @map("objectif_1_date_exacte")
  objectif1Categorie  String? @map("objectif_1_categorie")
  objectif2DateExacte String? @map("objectif_2_date_exacte")
  objectif2Categorie  String? @map("objectif_2_categorie")
  // Partie 3 : axes de progression ordonnés (3 max) et fiche de l'événement (champs propres à chaque sport).
  objectif1Details    Json?   @map("objectif_1_details")
  objectif2Details    Json?   @map("objectif_2_details")
  // Partie 3 (mission 7) : alternance de deux semaines A / B — { a, b, anchor (lundi de la semaine A) }.
  weekAlternance      Json?   @map("week_alternance")
  // Programme "principal" (compat : lu partout où un seul programme est attendu).
  programme         String
  // Programmes actifs simultanés (page /settings · "Choix de programme"). Vide
  // sur les comptes antérieurs à sept. 2026 → repli sur [programme].
  programmes        String[] @default([])
  niveau            String
  sportPrincipal    String   @map("sport_principal")
  // Semaine type enrichie (multi-jours, multi-créneaux) — remplace sportSecondaire/joursS1.../niveauS2.
  weekCycle         Json?    @map("week_cycle")
  // Dépréciés (sept. 2026) — remplacés par weekCycle. Gardés pour compat avec les
  // comptes créés avant cette migration, plus lus/écrits par l'app.
  sportSecondaire   String?  @map("sport_secondaire")
  joursS1           String[] @default([]) @map("jours_s1")
  heureS1           String?  @map("heure_s1")
  dureeS1           String?  @map("duree_s1")
  niveauS1          String?  @map("niveau_s1")
  joursS2           String[] @default([]) @map("jours_s2")
  heureS2           String?  @map("heure_s2")
  dureeS2           String?  @map("duree_s2")
  niveauS2          String?  @map("niveau_s2")
  equipement        String
  jeune             Boolean
  typeJeune         String?  @map("type_jeune")
  debutFenetre      String?  @map("debut_fenetre")
  finFenetre        String?  @map("fin_fenetre")
  restrictions      String[]
  hydratation       String
  blessures         Boolean
  blessuresDetail   String?  @map("blessures_detail")
  complements       String[]
  complementsAutres String?  @map("complements_autres")
  qualiteSommeil    String   @map("qualite_sommeil")
  dureeSommeil      String   @map("duree_sommeil")
  // Pas collecté au signup ECM actuel — rempli au premier check-in.
  genre             String?

  // Onboarding, réglages & préférences (page /settings).
  onboardingDone   Boolean  @default(false) @map("onboarding_done")
  recordsRm        Json?    @map("records_rm")
  notifCheckinOn   Boolean  @default(true) @map("notif_checkin_on")
  notifCheckinTime String?  @default("07:00") @map("notif_checkin_time")
  notifSeance      Boolean  @default(true) @map("notif_seance")
  notifBlessure    Boolean  @default(true) @map("notif_blessure")
  notifRecap       Boolean  @default(false) @map("notif_recap")
  langue           String   @default("fr")
  // Partie 5 (mission 4) : thème, fuseau de l'appareil, réglages fins des notifications.
  theme            String   @default("dark")
  timezone         String?
  // Heure du récapitulatif du dimanche (paramétrable) ; le changement d'heure du rappel check-in
  // s'applique le lendemain (ancienne heure conservée jusqu'à notifCheckinTimeFrom).
  notifRecapTime        String? @default("19:00") @map("notif_recap_time")
  notifCheckinTimePrev  String? @map("notif_checkin_time_prev")
  notifCheckinTimeFrom  String? @map("notif_checkin_time_from")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  checkins         Checkin[]
  dashboardOutputs DashboardOutput[]
  sessions         Session[]
  extraActivities  ExtraActivity[]
  trainingBlocks   TrainingBlock[]
  weekOverrides    WeekOverride[]
  programPositions ProgramPosition[]
  chainProgress    ChainProgress[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
  sessionStarts     SessionStart[]

  @@map("profiles")
}

// Une entrée par jour et par utilisateur (contrainte unique userId+date).
model Checkin {
  id     String @id @default(cuid())
  userId String @map("user_id")
  date   String // clé YYYY-MM-DD

  genre           String
  energie         Int?
  motivation      Int?
  mental          String?
  stress          String?
  libido          String?
  jambes          String?
  douleur         Boolean?
  douleurDetail   String?  @map("douleur_detail")
  sleepPhoto      Boolean  @default(false) @map("sleep_photo")
  sleepCoucher    String?  @map("sleep_coucher")
  sleepReveil     String?  @map("sleep_reveil")
  sleepDuree      String?  @map("sleep_duree")
  sleepFc         String?  @map("sleep_fc")
  sleepHrv        String?  @map("sleep_hrv")
  sleepRecup      String?  @map("sleep_recup")
  sleepAnalysis   Json?    @map("sleep_analysis")
  recuperationPercue String? @map("recuperation_percue")
  poids           String?
  seance          String?
  travail         Boolean?
  soirPerformance Boolean? @map("soir_performance")
  cycle           Boolean?
  cycleDouleur    String?  @map("cycle_douleur")
  cycleJour       String?  @map("cycle_jour")
  nutrition       String?
  hydratation     String?
  notes           String?

  // Personnalisation facultative de la séance du jour.
  seanceFocus       String[] @map("seance_focus")
  seanceDuree       String?  @map("seance_duree")
  seanceEquipement  String?  @map("seance_equipement")
  seanceIntensite   String?  @map("seance_intensite")
  seanceNote        String?  @map("seance_note")
  /** Format demandé : "complet" | "deux_blocs" | "un_bloc" (partie 2, 1.3 b). */
  seanceFormat      String?  @map("seance_format")
  /** Volume Block Hypertrophy : focus du jour — "upper" | "lower" | "full". */
  volumeBlockFocus String? @map("volume_block_focus")

  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@unique([userId, date])
  @@map("checkins")
}

// Plan quotidien généré par Claude (profil + check-in du jour). Un par user/jour.
model DashboardOutput {
  id     String @id @default(cuid())
  userId String @map("user_id")
  date   String

  output Json

  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@unique([userId, date])
  @@map("dashboard_outputs")
}

// Log de séance réalisée (variante choisie + éventuel détail sets/reps).
model Session {
  id     String @id @default(cuid())
  userId String @map("user_id")
  date   String

  variant   String? // "A" | "B"
  completed Boolean @default(false)
  data      Json?
  /** Part des mouvements cochés pendant la séance (0 à 1). */
  completionRate Float? @map("completion_rate")
  /** Durée totale de la séance, en secondes. */
  durationSec    Int?   @map("duration_sec")
  /** Ressenti de la séance : "difficile" | "moyen" | "correct" | "bon" | "excellent". */
  sessionFeeling String? @map("session_feeling")
  /** Note libre facultative laissée sur le compte rendu. */
  sessionNote    String? @map("session_note")
  /** Calories brûlées, relevées sur la montre. */
  caloriesBrulees Int?   @map("calories_brulees")
  /** Origine de la valeur : "manuel" (saisie) ou "photo_auto" (lue par Claude). */
  caloriesSource String? @map("calories_source")
  /** URLs Vercel Blob des photos de séance (2 max). */
  photos         String[] @default([])
  /** Meilleure série du jour (mouvement, charge, reps) pour le compte rendu. */
  bestResult     Json?  @map("best_result")
  /** Analyse Claude de la photo de séance : { donneesBrutes, retourNarratif }. */
  photoAnalysis  Json?  @map("photo_analysis")

  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@unique([userId, date])
  @@map("sessions")
}

// 2e (ou 3e...) activité d'une même journée (doc G.3) — table séparée plutôt
// que de toucher la contrainte userId+date de Session (utilisée partout
// ailleurs comme "la" séance du jour) : un utilisateur peut faire CrossFit
// Pure le matin et une marche le soir sans dupliquer le check-in quotidien.
// `seance` est fixé ici (pas sur Checkin, qui reste la déclaration du matin,
// unique par jour).
model ExtraActivity {
  id     String @id @default(cuid())
  userId String @map("user_id")
  date   String
  seance String
  /** Heure réelle de l'activité ("HH:MM"), saisie à l'ajout — détermine sa
   * position parmi les blocs du dashboard, pas l'ordre d'ajout (doc G.3). */
  heureReelle String? @map("heure_reelle")

  completed Boolean @default(false)
  data      Json?
  completionRate Float? @map("completion_rate")
  durationSec    Int?   @map("duration_sec")
  sessionFeeling String? @map("session_feeling")
  sessionNote    String? @map("session_note")
  caloriesBrulees Int?   @map("calories_brulees")
  caloriesSource String? @map("calories_source")
  photos         String[] @default([])
  bestResult     Json?  @map("best_result")
  photoAnalysis  Json?  @map("photo_analysis")
  /** Message de félicitations généré via generateSessionCongrats, même
   * traitement que la séance principale (doc G.3, pas de bloc dégradé). */
  coachMessage   String? @map("coach_message")

  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@index([userId, date])
  @@map("extra_activities")
}

// Bloc d'entraînement en cours (partie 2, 1.6 / 2.1) : thème, durée en semaines
// (décharge comprise), points faibles. Un seul bloc actif par programme.
model TrainingBlock {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  programme  String // slug du programme
  theme      String   @default("equilibre")
  weeks      Int      @default(5)
  startDate  String   @map("start_date") // YYYY-MM-DD (lundi de la semaine 1)
  weakPoints String[] @default([]) @map("weak_points")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@index([userId, programme, active])
  @@map("training_blocks")
}

// Modification d'une semaine précise (partie 2, 1.5 / 2.8) : remplace la semaine
// type pour cette semaine uniquement. "Toujours" modifie profile.weekCycle.
model WeekOverride {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  weekStart String   @map("week_start") // YYYY-MM-DD du lundi
  cycle     Json
  createdAt DateTime @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@unique([userId, weekStart])
  @@map("week_overrides")
}

// Position de l'utilisateur dans la suite ordonnée de séances d'un programme (1.4).
model ProgramPosition {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  programSlug String   @map("program_slug")
  position    Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@unique([userId, programSlug])
  @@map("program_positions")
}

// Niveau actuel dans une chaîne de progression At Home (2.7).
model ChainProgress {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  chain     String
  level     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [userId], references: [userId])

  @@unique([userId, chain])
  @@map("chain_progress")
}

// Partie 5 : abonnements push de l'app web (un par appareil / navigateur).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  /// Appareil reconnu à l'abonnement : "iphone" | "android" | "ordinateur".
  device     String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Partie 5 : une notification n'est envoyée qu'une fois par (utilisateur, type, clé) — clé = jour, créneau, période.
model NotificationLog {
  id     String   @id @default(cuid())
  userId String   @map("user_id")
  kind   String
  key    String
  sentAt DateTime @default(now()) @map("sent_at")
  /// Jour local de l'utilisateur (YYYY-MM-DD) : sert au plafond de 3 notifications par jour.
  day    String   @default("")
  /// "ok" (au moins un appareil atteint), "echec" (aucun appareil atteint), "test".
  result String   @default("ok")
  detail String?
  attempts Int    @default(1)

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@index([userId, day])
  @@map("notification_logs")
}

// Partie 6 : "Démarrer la séance" appuyé (la ligne Session n'est écrite qu'à la fin). Sert à ne pas
// envoyer le rappel d'une séance déjà commencée.
model SessionStart {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  startedAt DateTime @default(now()) @map("started_at")

  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId, startedAt])
  @@map("session_starts")
}

// ---------------------------------------------------------------------------------------------------------
// Partie 6 · mission 2 : bibliothèque de mouvements, enchaînements, WODs et séances modèles.
// Source officielle : les quatre listes de data/library/*.txt, importées par scripts/import-library.ts
// (relançable, sans doublon). Ces tables sont des bibliothèques : rien ici n'est affecté à un jour, un
// programme ou une semaine enregistrée.
// ---------------------------------------------------------------------------------------------------------

model LibMovement {
  id   String @id @default(cuid())
  /// Nom normalisé (casse, tiret, espace, pluriel ignorés) : un seul mouvement par clé.
  key  String @unique
  /// Nom en anglais, tel qu'écrit dans la liste. Jamais traduit.
  name String
  /// Autres écritures rencontrées dans les listes pour ce même mouvement (même clé).
  aliases String[] @default([])
  /// Clés de catégories (ex. "POUSSÉE VERTICALE"), affichées dans la langue de l'utilisateur.
  categories String[] @default([])
  /// musculation | gainage | endurance | metcon | echauffement | retour_au_calme | a_definir
  type    String
  sources String[] @default([])
  equipment String[] @default([])
  videoUrl  String? @map("video_url")
  /// "importe_a_completer" tant qu'un coach n'a pas validé la fiche.
  status    String  @default("importe_a_completer")
  /// Identifiant du mouvement correspondant dans movements.ts quand il existe déjà dans l'app.
  appMovementId String? @map("app_movement_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines LibLine[] @relation("LineMovement")
  altLines LibLine[] @relation("LineAltMovement")

  @@map("lib_movements")
}

/// Enchaînement ([COMBO]) : liste ordonnée de mouvements.
model LibCombo {
  id   String @id @default(cuid())
  key  String @unique
  name String
  /// Identifiants LibMovement, dans l'ordre.
  movementIds String[] @default([]) @map("movement_ids")
  sources     String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines LibLine[]

  @@map("lib_combos")
}

model LibWod {
  id   String @id @default(cuid())
  key  String @unique
  name String
  /// "The Girls" | "Hero" | "Open" | nom du groupe de la source.
  group    String
  subgroup String?
  source   String
  format   String?
  scheme   String?
  timeCap  String? @map("time_cap")
  /// Titre exact de la liste.
  rawTitle String  @map("raw_title")
  /// Ordre dans la source.
  position Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines LibLine[]

  @@map("lib_wods")
}

model LibTemplate {
  id   String @id @default(cuid())
  key  String @unique
  name String
  source   String
  group    String
  format   String?
  scheme   String?
  rawTitle String @map("raw_title")
  position Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lines LibLine[]

  @@map("lib_templates")
}

/// Une ligne ordonnée d'un WOD ou d'une séance modèle. La quantité appartient à la ligne, jamais au mouvement.
model LibLine {
  id         String  @id @default(cuid())
  wodId      String? @map("wod_id")
  templateId String? @map("template_id")
  position   Int
  /// Partie de la séance (Warm-up, Strength, Conditioning, Accessory / Core, Mobility) ou du WOD (Partie 1, Série 1).
  part       String?
  partFormat String? @map("part_format")
  /// "movement" | "combo" | "choice"
  kind       String
  /// Quantité telle qu'écrite (répétitions, distance, calories, durée, séries × répétitions).
  quantity   String?
  /// Emplacement dans un EMOM (M1, M2...).
  slot       String?
  note       String?
  /// Ligne telle qu'écrite dans la liste.
  raw        String
  movementId    String? @map("movement_id")
  comboId       String? @map("combo_id")
  /// Choix : première alternative = movementId, seconde = altMovementId.
  altMovementId String? @map("alt_movement_id")

  wod         LibWod?      @relation(fields: [wodId], references: [id], onDelete: Cascade)
  template    LibTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  movement    LibMovement? @relation("LineMovement", fields: [movementId], references: [id])
  altMovement LibMovement? @relation("LineAltMovement", fields: [altMovementId], references: [id])
  combo       LibCombo?    @relation(fields: [comboId], references: [id])

  @@index([wodId, position])
  @@index([templateId, position])
  @@map("lib_lines")
}

/// Journal des imports : un rapport par exécution.
model LibImportRun {
  id        String   @id @default(cuid())
  startedAt DateTime @default(now()) @map("started_at")
  report    Json

  @@map("lib_import_runs")
}
